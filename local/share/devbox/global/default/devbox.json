{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": {
    "vips": {
      "version": "latest",
      "outputs": ["out", "dev", "bin"]
    },
    "poppler": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "neovim":                       "latest",
    "vscode-langservers-extracted": "latest",
    "jq":                           "latest",
    "hocr-tools":                   "latest",
    "llama-cpp":                    "latest",
    "tesseract":                    "latest",
    "sentencepiece": {
      "version": "latest",
      "outputs": ["bin", "dev", "out"]
    },
    "cmake":         "latest",
    "rust-analyzer": "latest",
    "fzf":           "latest",
    "aws-sam-cli":   "latest",
    "opkssh":        "0.8.0",
    "vfkit":         "latest",
    "qemu":          "7.0.0",
    "podman":        "4.9.3",
    "lastpass-cli":  "latest",
    "wget":          "latest",
    "rcm":           "latest",
    "git":           "latest",
    "openssl": {
      "version": "latest",
      "outputs": ["bin", "dev", "out"]
    },
    "tmuxp":                      "latest",
    "tmux":                       "latest",
    "reattach-to-user-namespace": "latest",
    "ag":                         "latest",
    "typescript-language-server": "latest",
    "direnv":                     "latest",
    "gh":                         "latest",
    "asdf-vm":                    "latest",
    "awscli":                     "latest",
    "pkg-config":                 "latest",
    "claude-code":                "latest",
    "zlib": {
      "version": "latest",
      "outputs": ["out", "dev", "static"]
    },
    "llvm_21": {
      "version": "latest",
      "outputs": ["dev", "out", "lib", "python"]
    },
    "clang":     "latest",
    "coreutils": "latest",
    "readline": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "libffi": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "ncurses": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "libyaml": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "libyaml.dev": "",
    "libiconv": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "iconv": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "libxml2": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "libxslt": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "xz": "latest"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
